{
  "schema": "granted-hours-print-desk-calendar-preset-v1",
  "edition_id": "desk-calendar-v1",
  "description": "210 x 140 mm landscape printable desk-calendar study, one civil day per page.",
  "source": {
    "canonical_timetable_data": "src/timetable/timetable-data.js",
    "artwork_asset_preference": [
      "archive/{year}/{month}/{date}/assets/visual-preview.webp",
      "archive/{year}/{month}/{date}/assets/preview.png",
      "docs/archive/{year}/{month}/{date}/assets/visual-preview.webp",
      "docs/archive/{year}/{month}/{date}/assets/preview.png"
    ]
  },
  "date_selection": {
    "from": "first_public_day",
    "through": "latest_public_day"
  },
  "page": {
    "width_mm": 210,
    "height_mm": 140,
    "orientation": "landscape",
    "margin_mm": 8,
    "binding_band_mm": 10,
    "cover": true
  },
  "layout": {
    "day_body_top_from_top_mm": 18,
    "day_main_height_mm": 60,
    "day_left_width_mm": 82,
    "day_artwork_x_mm": 96,
    "day_artwork_width_mm": 106,
    "timeline_track_start_mm": 28,
    "timeline_track_end_mm": 180,
    "cards_width_mm": 164,
    "cards_gap_mm": 2.5,
    "card_height_mm": 14,
    "cards_base_y_mm": 9,
    "cards_row_gap_mm": 2.2
  },
  "artwork": {
    "aspect_ratio": [16, 9],
    "cache_width_px": 1200,
    "jpeg_quality": 86,
    "crop": "center"
  },
  "content": {
    "timeline_rows": [
      "self",
      "collaboration",
      "reminder",
      "routine"
    ],
    "max_cards": 4,
    "max_collaboration_cards": 2,
    "max_reminder_cards": 2,
    "include_routine_rollup": true,
    "card_text_overflow": "ellipsis"
  },
  "qr": {
    "base_url": "https://granted-hours.hyperint.net/timetable/",
    "error_correction": "Q",
    "border_modules": 4,
    "day_size_mm": 18.5,
    "day_y_mm": 11,
    "cover_size_mm": 19,
    "cover_y_mm": 9,
    "qa_crop_padding_mm": 3
  },
  "palette": {
    "paper": "#F2EEE3",
    "paper_deep": "#E7E0D1",
    "ink": "#11171B",
    "ink_soft": "#4C5354",
    "graphite": "#11171B",
    "bone": "#F2EEE3",
    "gold": "#B58942",
    "gold_light": "#D8BB78",
    "cyan": "#4E8FA0",
    "cyan_light": "#A8CCD0",
    "sage": "#7E9181",
    "sage_light": "#C3CDC0",
    "amber": "#C97942",
    "violet": "#777187",
    "red": "#A85C55",
    "white": "#FFFFFF"
  },
  "proof": {
    "dates": [
      "2026-05-07",
      "2026-06-23",
      "2026-07-11",
      "2026-08-12",
      "latest_public_day"
    ]
  },
  "qa": {
    "dpi": 180,
    "require_qr_decode": true,
    "page_size_tolerance_mm": 0.02
  },
  "output": {
    "full_directory": "output/pdf",
    "proof_directory": "tmp/pdfs",
    "full_filename_template": "granted-hours-desk-calendar-{from_date}-to-{through_date}-v1.pdf",
    "proof_filename_template": "granted-hours-desk-calendar-proof-{from_date}-to-{through_date}-v1.pdf"
  },
  "print_contract": {
    "civil_day_policy": "One page for every public timetable civil day; absence days remain visibly absent and are never backfilled with invented artworks.",
    "content_priority": [
      "date_and_titles",
      "autonomous_artwork_or_absence_beacon",
      "truthful_24_hour_strata",
      "collaboration_and_reminder_cards",
      "routine_rollup",
      "exact_day_qr"
    ],
    "production_notes": [
      "Warm white paper field with black typography and restrained color accents.",
      "Artwork stills use center-cropped 16:9 cached JPEGs; the live work remains canonical.",
      "Card overflow is ellipsized; the exact event footprint remains in the timeline strata.",
      "Changing geometry or content priority requires a new preset version and a proof QA pass."
    ]
  }
}
